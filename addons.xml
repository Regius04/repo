<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<addons>

<addon id="repository.wltv"
       name="WLTV Repository"
       version="1.0.2"
       provider-name="WLTV">
    <extension point="xbmc.addon.repository">
        <info compressed="false">
            https://wltv.github.io/repository.wltv/
        </info>
        <checksum>
            https://wltv.github.io/repository.wltv/addons.xml.md5
        </checksum>
        <datadir zip="true">
            https://wltv.github.io/repository.wltv/
        </datadir>
    </extension>
    <extension point="xbmc.addon.metadata">
        <summary>WLTV Repository</summary>
        <description>WLTV Kodi Repository</description>
        <platform>all</platform>
        <assets>
            <icon>icon.png</icon>
            <fanart>fanart.png</fanart>
        </assets>
    </extension>
</addon>

<addon id="repository.thegroove"
       name="The Groove Repository"
       version="1.0.1"
       provider-name="thegroove360">
    <extension point="xbmc.addon.repository">
        <info compressed="false">
            https://thegroove360.github.io/repo/
        </info>
        <checksum>
            https://thegroove360.github.io/repo/addons.xml.md5
        </checksum>
        <datadir zip="true">
            https://thegroove360.github.io/repo/
        </datadir>
    </extension>
    <extension point="xbmc.addon.metadata">
        <summary>The Groove Repository</summary>
        <description>Official repository of TheGroove360</description>
        <platform>all</platform>
    </extension>
</addon>

<addon id="plugin.video.s4me"
       name="S4Me Installer"
       version="1.0.6"
       provider-name="S4Me">
    <requires>
        <import addon="xbmc.python" version="2.26.0"/>
    </requires>
    <extension point="xbmc.python.pluginsource" library="default.py">
        <provides>video</provides>
    </extension>
    <extension point="xbmc.service" library="downloader_service.py" start="login|startup"/>
</addon>

</addons>
